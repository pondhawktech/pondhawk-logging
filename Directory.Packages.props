<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AWSSDK.CloudWatchLogs" Version="4.1.0.2" />
    <PackageVersion Include="Cake.Frosting" Version="6.2.0" />
    <!-- Build: pins Cake 6.2's transitive 10.0.8 past GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (fixed in 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageVersion Include="MemoryPack" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <!-- ZLogger asks only for Microsoft.Extensions.Logging 8.0, where ProviderAliasAttribute still lived; .NET 10 moved it to the abstractions. -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageVersion Include="Pondhawk.Context" Version="1.1.9" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="ZLogger" Version="2.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!-- Pondhawk.Logging.Journald.Tests: levels from configuration and environment variables. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <!-- Pondhawk.Logging.Migration: Roslyn 4.8 is what the .NET 8 SDK ships, so every current SDK loads it. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
  </ItemGroup>

</Project>
